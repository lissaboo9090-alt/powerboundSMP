package beta.teneitri.powerboundSMP;

import org.bukkit.ChatColor;
import org.bukkit.Particle;
import org.bukkit.Sound;
import org.bukkit.entity.Player;
import org.bukkit.event.EventHandler;
import org.bukkit.event.Listener;
import org.bukkit.event.entity.PlayerDeathEvent;

public class ReturnByDeathPowerListener implements Listener {

    @EventHandler
    public void onReturnByDeath(PlayerDeathEvent event) {
        Player player = event.getEntity();

        if (!player.getScoreboardTags().contains("return_by_death")) return;

        event.setKeepInventory(true);
        event.setKeepLevel(true);
        
        event.getDrops().clear();
        event.setDroppedExp(0);

        player.getWorld().playSound(player.getLocation(), Sound.ENTITY_WITHER_SPAWN, 0.8f, 0.5f);
        player.getWorld().spawnParticle(Particle.LARGE_SMOKE, player.getLocation().add(0, 1, 0), 45, 0.5, 0.5, 0.5, 0.02);

        player.sendMessage(ChatColor.DARK_RED + " RETURN BY DEATH: Your soul returns, leaving your belongings untouched.");
    }
}
